pragma language_version 0.23;

export ledger isAdult: boolean;

export circuit verifyAge(age: number): [] {
    // Check that the age is 18 or older
    // The age is a private witness and is not revealed on the blockchain
    assert (age >= 18);
    
    // Only the result (true) is disclosed to the public ledger state
    isAdult = disclose(true);
}
